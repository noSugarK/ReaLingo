{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaLingo",
  "identifier": "com.nosugark.realingo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReaLingo",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "subtitle",
        "url": "subtitle.html",
        "title": "ReaLingo Subtitle",
        "width": 960,
        "height": 220,
        "x": 200,
        "y": 700,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": { "csp": null },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "pulseaudio-utils"]
      }
    }
  }
}
